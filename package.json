    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-user-questions": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.1",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.1",
