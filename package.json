    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-typert-protocol@<0.2.0": "0.2.1-rc.1"
